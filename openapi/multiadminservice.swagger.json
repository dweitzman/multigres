    "/v1/poolers": {
      "get": {
        "summary": "GetPoolers retrieves poolers filtered by cells and/or database",
        "operationId": "MultiAdminService_GetPoolers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/multiadminGetPoolersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",

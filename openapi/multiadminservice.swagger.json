  "paths": {
    "/v1/backup-jobs/{jobId}": {
      "get": {
        "summary": "GetBackupJobStatus checks the status of a backup or restore job",
        "operationId": "MultiAdminService_GetBackupJobStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/multiadminGetBackupJobStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "jobId",
            "description": "job_id to query (required)",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "database",
            "description": "Shard context for fallback lookup via MultiPooler when job is not in memory.\nRequired when job may have been lost due to process restart.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "tableGroup",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "shard",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "MultiAdminService"
        ]
      }
    },
    "/v1/backups": {
      "get": {
        "summary": "GetBackups lists backup artifacts with optional filtering",
        "operationId": "MultiAdminService_GetBackups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/multiadminGetBackupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "database",
            "description": "database name to filter by (optional, empty means all databases)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "tableGroup",
            "description": "table_group name to filter by (optional, empty means all table groups)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "shard",
            "description": "shard name to filter by (optional, empty means all shards)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "limit on number of results (optional, 0 means no limit)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "MultiAdminService"
        ]
      },
      "post": {
        "summary": "Backup starts an async backup of a specific shard",
        "operationId": "MultiAdminService_Backup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/multiadminBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/multiadminBackupRequest"
            }
          }
        ],
        "tags": [
          "MultiAdminService"
        ]
      }
    },

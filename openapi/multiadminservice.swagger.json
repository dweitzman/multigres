  },
  "definitions": {
    "IDComponentType": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "MULTIPOOLER",
        "MULTIGATEWAY",
        "MULTIORCH"
      ],
      "default": "UNKNOWN",
      "description": "- UNKNOWN: UNKNOWN represents an unknown or uninitialized component type\n - MULTIPOOLER: MULTIPOOLER represents a multipooler component\n - MULTIGATEWAY: MULTIGATEWAY represents a multigateway component\n - MULTIORCH: MULTIORCH represents a multiorch component",
      "title": "ComponentType represents the type of Multigres component"
    },
    "clustermetadataCell": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name for this cell"
        },
        "serverAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "server_address is the network address of the cell topology service."
        },
        "root": {
          "type": "string",
          "description": "root is the namespace or directory path within the topology service\nwhere this cell's metadata is stored. Used only when connecting to server_addresses."
        }
      },
      "description": "Cell describes how to connect to a cell topology.\nThese records are stored in the global topology server."
    },
    "clustermetadataDatabase": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Name of the database"
        },
        "backupLocation": {
          "type": "string",
          "title": "Backups location"
        },
        "durabilityPolicy": {
          "type": "string",
          "title": "Durability policy used for consensus"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "List of cell identifiers where this database should be deployed"
        }
      }
    },
    "clustermetadataID": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/definitions/IDComponentType",
          "title": "component identifies the type of Multigres component (multipooler, multigateway, or multiorch)"
        },
        "cell": {
          "type": "string",
          "title": "cell is the Multigres cell where the component is located"
        },
        "name": {
          "type": "string",
          "description": "name is a unique identifier for the component within the multigres\ncluster."
        }
      },
      "description": "ID is a globally unique pooler identifier."
    },
    "clustermetadataKeyRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "byte",
          "title": "start is the start key of the range (inclusive)"
        },
        "end": {
          "type": "string",
          "format": "byte",
          "title": "end is the end key of the range (exclusive)"
        }
      },
      "title": "KeyRange represents a range of keys for sharding"
    },
    "clustermetadataMultiGateway": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/clustermetadataID",
          "description": "id is the unique name of the multi gateway in the cluster."
        },
        "hostname": {
          "type": "string",
          "description": "Fully qualified domain name of the host."
        },
        "portMap": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          },
          "description": "Map of named ports. Normally this should include postgres and grpc."
        }
      },
      "description": "MultiGateway represents metadata about a running multigateway component instance in the cluster."
    },
    "clustermetadataMultiOrch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/clustermetadataID",
          "description": "id is the unique name of the MultiOrch in the cluster."
        },
        "hostname": {
          "type": "string",
          "description": "Fully qualified domain name of the host."
        },
        "portMap": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          },
          "description": "Map of named ports. These are ports that MultiOrc exposes."
        }
      },
      "description": "MultiOrch represents information about a running instance of multiorch."
    },
    "clustermetadataMultiPooler": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/clustermetadataID",
          "description": "id is the unique identifier of the multipooler in the cluster."
        },
        "database": {
          "type": "string",
          "description": "Database name."
        },
        "tableGroup": {
          "type": "string",
          "description": "TableGroup name."
        },
        "shard": {
          "type": "string",
          "description": "Shard name. If range based sharding is used, it should match\nkey_range."
        },
        "keyRange": {
          "$ref": "#/definitions/clustermetadataKeyRange",
          "description": "If range based sharding is used, range for the pooler's shard."
        },
        "type": {
          "$ref": "#/definitions/clustermetadataPoolerType",
          "title": "PoolerType is the kind of pooler: PRIMARY or REPLICA"
        },
        "servingStatus": {
          "$ref": "#/definitions/clustermetadataPoolerServingStatus",
          "description": "PoolerServingStatus is the current type of the pooler."
        },
        "hostname": {
          "type": "string",
          "description": "Fully qualified domain name of the host."
        },
        "portMap": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          },
          "title": "Map of named ports. These are ports that the pooler exposes. Initially, this will only be gRPC"
        }
      },
      "description": "MultiPooler represents metadata about a running multipooler component instance in the cluster."
    },
    "clustermetadataPoolerServingStatus": {
      "type": "string",
      "enum": [
        "SERVING",
        "NOT_SERVING",
        "BACKUP",
        "RESTORE",
        "DRAINED",
        "SERVING_RDONLY"
      ],
      "default": "SERVING",
      "description": "PoolerServingStatus represents the serving status of the given MultiPooler.\n\n - SERVING: SERVING is the status a server during normal operations when it is serving traffic.\n - NOT_SERVING: NOT_SERVING is the status of a server when it is not serving traffic.\nThis typically occurs during startup, shutdown, or when the server is\nin an error state and cannot accept connections.\n - BACKUP: BACKUP is the status of a server when it is taking a backup. No queries\ncan be served in BACKUP mode.\n - RESTORE: RESTORE is the status a server uses when restoring a backup, at\nstartup time.  No queries can be served in RESTORE mode.\n - DRAINED: DRAINED is the status a server goes into when used by Multigres tools\nto perform an offline action. It is a serving type (as\nthe tools processes may need to run queries), but it's not used\nto route queries from Multigres users. In this state,\nthis multipooler is dedicated to the process that uses it.\n - SERVING_RDONLY: SERVING_RDONLY is the status of a server in read-only mode.\nThis is used during demotion when the server transitions from PRIMARY to REPLICA,\nor for read-only replicas. The server accepts connections but only serves read queries."
    },
    "clustermetadataPoolerType": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "PRIMARY",
        "REPLICA"
      ],
      "default": "UNKNOWN",
      "description": "PoolerType represents the type of a given MultiPooler.\n\n - UNKNOWN: UNKNOWN this is not a valid type.\nIt is useful during upgrades to detect when a value is not initialized\n - PRIMARY: PRIMARY is the primary server for the shard. Only PRIMARY allows DMLs.\n - REPLICA: REPLICA replicates from leader. It is used to read only traffic"
    },
    "googlerpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "multiadminBackupInfo": {
      "type": "object",
      "properties": {
        "backupId": {
          "type": "string",
          "title": "backup_id uniquely identifies this backup (e.g., \"20250117-123456F\")"
        },
        "database": {
          "type": "string",
          "title": "database name"
        },
        "tableGroup": {
          "type": "string",
          "title": "table_group name"
        },
        "shard": {
          "type": "string",
          "title": "shard name"
        },
        "type": {
          "type": "string",
          "title": "type of backup: \"full\", \"differential\", or \"incremental\""
        },
        "status": {
          "$ref": "#/definitions/multiadminBackupStatus",
          "title": "status of the backup"
        },
        "backupTime": {
          "type": "string",
          "format": "date-time",
          "title": "backup_time is when the backup was created"
        },
        "backupSizeBytes": {
          "type": "string",
          "format": "uint64",
          "title": "backup_size_bytes is the size of the backup in bytes"
        },
        "multipoolerServiceId": {
          "type": "string",
          "title": "multipooler_service_id is the ID of the multipooler that reported the backup"
        },
        "poolerType": {
          "$ref": "#/definitions/clustermetadataPoolerType",
          "title": "pooler_type is the type of the multipooler (PRIMARY or REPLICA)"
        }
      },
      "title": "BackupInfo contains information about a single backup artifact"
    },
    "multiadminBackupRequest": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "title": "database name (required)"
        },
        "tableGroup": {
          "type": "string",
          "title": "table_group name (required)"
        },
        "shard": {
          "type": "string",
          "title": "shard name (required)"
        },
        "type": {
          "type": "string",
          "title": "type of backup: \"full\", \"differential\", or \"incremental\" (required)"
        },
        "forcePrimary": {
          "type": "boolean",
          "description": "force_primary forces the backup to run on the primary instead of a replica.\nThis should typically be false because backups on replicas reduce load on the primary."
        }
      },
      "title": "BackupRequest requests an async backup of a specific shard"
    },
    "multiadminBackupResponse": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "title": "job_id is the unique identifier for tracking this backup job"
        }
      },
      "title": "BackupResponse contains the job ID for tracking the async backup"
    },
    "multiadminBackupStatus": {
      "type": "string",
      "enum": [
        "BACKUP_STATUS_UNKNOWN",
        "BACKUP_STATUS_INCOMPLETE",
        "BACKUP_STATUS_COMPLETE",
        "BACKUP_STATUS_FAILED"
      ],
      "default": "BACKUP_STATUS_UNKNOWN",
      "title": "BackupStatus indicates the state of a backup artifact"
    },
    "multiadminGetBackupJobStatusResponse": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "title": "job_id is the unique identifier for this job"
        },
        "jobType": {
          "$ref": "#/definitions/multiadminJobType",
          "title": "job_type indicates whether this is a backup or restore job"
        },
        "status": {
          "$ref": "#/definitions/multiadminJobStatus",
          "title": "status indicates the current state of the job"
        },
        "errorMessage": {
          "type": "string",
          "title": "error_message contains the error if status is FAILED"
        },
        "database": {
          "type": "string",
          "title": "Original request context"
        },
        "tableGroup": {
          "type": "string"
        },
        "shard": {
          "type": "string"
        },
        "backupType": {
          "type": "string",
          "description": "\"full\", \"differential\", \"incremental\"",
          "title": "For backup jobs"
        },
        "requestedBackupId": {
          "type": "string",
          "description": "What was requested (may be empty for \"latest\")",
          "title": "For restore jobs"
        },
        "backupId": {
          "type": "string",
          "title": "Results (set when status = COMPLETED)\nFor backup: created backup_id\nFor restore: backup_id that was restored"
        }
      },
      "title": "GetBackupJobStatusResponse contains the current status of a backup or restore job"
    },
    "multiadminGetBackupsResponse": {
      "type": "object",
      "properties": {
        "backups": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/multiadminBackupInfo"
          },
          "title": "backups is the list of backup information"
        }
      },
      "title": "GetBackupsResponse contains the list of backup artifacts"
    },
    "multiadminGetCellNamesResponse": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "GetCellNamesResponse contains all cell names"
    },
    "multiadminGetCellResponse": {
      "type": "object",
      "properties": {
        "cell": {
          "$ref": "#/definitions/clustermetadataCell",
          "title": "cell contains the Cell protobuf object"
        }
      },
      "title": "GetCellResponse contains the cell information"
    },
    "multiadminGetDatabaseNamesResponse": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "GetDatabaseNamesResponse contains all database names"
    },
    "multiadminGetDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/clustermetadataDatabase",
          "title": "database contains the Database protobuf object"
        }
      },
      "title": "GetDatabaseResponse contains the database information"
    },
    "multiadminGetGatewaysResponse": {
      "type": "object",
      "properties": {
        "gateways": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clustermetadataMultiGateway"
          }
        }
      },
